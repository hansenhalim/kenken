rules_version = '2'

service cloud.firestore {
  match /databases/{database}/documents {
    // One restaurant, one shared list of orders: any waiter must be able to
    // read every table and add to it. Signing in is the whole boundary.
    // Orders carry `createdByUid`, so authorship can be enforced here later
    // without touching the data.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
